def program {
    function empty Main()
    {
        double precio = 19.99;
        float descuento = 0.1f;
        Term.out("total: " + (precio - precio * descuento));

        int s = Sum(1, 2);
        Term.out("suma: " + s);
    }

    function int Sum(int a, int b)
    {
        return a + b;
    }
}
